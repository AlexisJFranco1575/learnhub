DATABASE_URL="postgresql://learnhub:learnhub@localhost:5432/learnhub?schema=public"
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-random-string-of-32-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

SEED_ADMIN_EMAIL="admin@learnhub.dev"
SEED_ADMIN_PASSWORD="change-me"

# Optional settings (see the root README):
# TRUST_PROXY=1                  number of reverse proxies in front of the app
# CORS_ORIGIN=http://localhost:4200
# SEED_DEMO_DATA=true            create demo users and courses in production