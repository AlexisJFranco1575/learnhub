# Used by `docker compose --profile full up --build`.
# Copy this file to `.env` and set real values.

# Two DIFFERENT random secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

SEED_ADMIN_EMAIL=admin@learnhub.dev
SEED_ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:4200